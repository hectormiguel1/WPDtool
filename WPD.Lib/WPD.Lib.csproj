<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NativeLib>Shared</NativeLib>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <AssemblyName>WPD.Lib</AssemblyName>
        <RootNamespace>WPD</RootNamespace>
        <Version>1.0.0</Version>
        <Description>Library for repacking FINAL FANTASY XIII trilogy image files.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\IMGBlibrary\IMGBlibrary.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\NativeLogger\**\*.cs"
                 LinkBase="NativeLogger" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Native\" />
    </ItemGroup>
    
</Project>