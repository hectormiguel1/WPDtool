<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NativeLib>Shared</NativeLib>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <AssemblyName>WPDTool</AssemblyName>
        <RootNamespace>WPDtool</RootNamespace>
        <Version>1.0.0</Version>
        <Description>Library for repacking FINAL FANTASY XIII trilogy image files.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\IMGBlibrary\IMGBlibrary.csproj" />
    </ItemGroup>

    <Target Name="GenerateDllHash" BeforeTargets="BeforeBuild" Condition="Exists('$(ImgLibPath)')">
        <Message Importance="High" Text="Computing hash for $(ImgLibPath)..." />

        <GetFileHash Files="$(ImgLibPath)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="DllHashInfo" />
        </GetFileHash>

        <PropertyGroup>
            <ComputedHash>@(DllHashInfo->Metadata('FileHash'))</ComputedHash>
            <GeneratedCode>
                // &lt;auto-generated /&gt;
                namespace WPDtool%3B

                internal static class BuildConstants
                {
                public const string ExpectedImgLibraryHash = "$(ComputedHash)"%3B
                }
            </GeneratedCode>
        </PropertyGroup>

        <WriteLinesToFile
                File="BuildConstants.g.cs"
                Lines="$(GeneratedCode)"
                Overwrite="true"
                WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="BuildConstants.g.cs" />
        </ItemGroup>
    </Target>

    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
        <DefineConstants>$(DefineConstants);AOT</DefineConstants>
    </PropertyGroup>


</Project>